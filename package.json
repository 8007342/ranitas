{
  "name": "ranitas",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy build/web --project-name ranitas",
    "check:assets": "node scripts/check-assets.mjs",
    "art:build": "node scripts/prepare-art.mjs && node scripts/make-icon.mjs",
    "art:emissive": "node scripts/make-emissive.mjs",
    "train:policy": "node scripts/train-policy.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "wrangler": "^4.0.0"
  }
}
